# Supabase and APP_BASE_URL are required for auth/library routes.
# Copy to .env.local when configuring development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Required for /chat only. Library and profile editing do not call OpenAI.
OPENAI_API_KEY=YOUR_SERVER_ONLY_OPENAI_API_KEY
# Select an available model supporting the required tool calls.
OPENAI_MODEL=YOUR_MODEL_NAME
# Trusted origin for auth redirects and /api/mcp URL, Host, and Origin checks.
APP_BASE_URL=http://localhost:3000

# Optional Open Library discovery; apply its migration before enabling.
OPEN_LIBRARY_ENABLED=false
# Use a real contact email when enabled; sent to Open Library in User-Agent.
OPEN_LIBRARY_CONTACT_EMAIL=

# Optional internet search via authenticated MCP and one bounded OpenAI Responses request.
WEB_SEARCH_ENABLED=false
# Optional override; otherwise uses OPENAI_MODEL, which must support web_search.
WEB_SEARCH_MODEL=
