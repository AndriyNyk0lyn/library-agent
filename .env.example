# Supabase and APP_BASE_URL are required for auth/library routes.
# Copy to .env.local when configuring development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# OpenAI is not used until chat is implemented.
OPENAI_API_KEY=YOUR_SERVER_ONLY_OPENAI_API_KEY
# Select an available model supporting the required tool calls.
OPENAI_MODEL=YOUR_MODEL_NAME
# Trusted origin for email confirmation/recovery redirects; MCP will later use /api/mcp.
APP_BASE_URL=http://localhost:3000
